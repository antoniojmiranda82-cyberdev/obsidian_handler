# Copy this file to .env on the local machine. Never commit live secrets.
# CouchDB / Obsidian Self-Hosted LiveSync
hostname=http://127.0.0.1:5984
dbname=obsidian_vault
username=CHANGE_ME
password=CHANGE_ME
passphrase=CHANGE_ME

# Local authenticated MCP bridge for the Asset/Dream operator
MCP_API_KEY=CHANGE_ME_STRONG_LOCAL_TOKEN
MCP_TRANSPORT=http
MCP_PORT=3100

# Ollama local-first models
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=mxbai-embed-large:latest
OLLAMA_GENERATE_URL=http://127.0.0.1:11434/api/generate
OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embed
OLLAMA_TAGS_URL=http://127.0.0.1:11434/api/tags

# Asset Ave + Dream Blvd memory scope
ASSET_DREAM_ROOT=Projects/asset-dream
OBSIDIAN_INBOX_DIR=01 - Inbox
OBSIDIAN_SCHEMA_FILE=SCHEMA.md
